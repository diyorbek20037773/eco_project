{
  "name": "ecopoint-qarshi-pilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/postbuild-standalone.mjs",
    "start": "prisma migrate deploy && next start",
    "start:standalone": "node scripts/check-env.mjs && prisma migrate deploy && node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:local": "node scripts/local-pg.mjs start",
    "db:local:stop": "node scripts/local-pg.mjs stop",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "user:create": "node scripts/create-user.mjs",
    "setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "test": "vitest run --root .",
    "test:unit": "vitest run --root . --project unit",
    "test:db": "vitest run --root . --project db",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "db:test:reset": "node scripts/reset-test-db.mjs --seed",
    "check:env": "node scripts/check-env.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.9",
    "next": "16.4.5",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.1.0"
  }
}
