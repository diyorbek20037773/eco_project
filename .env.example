# PostgreSQL ulanishi. Docker Compose ham, `npm run db:local` ham shu manzilni beradi.
# Tashqi PostgreSQL ishlatsangiz, o'z manzilingizni yozing.
DATABASE_URL="postgresql://ecopoint:ecopoint_local@localhost:5433/ecopoint"

# E2E va DB testlari uchun alohida baza (testlar uni tozalab qayta to'ldiradi).
TEST_DATABASE_URL="postgresql://ecopoint:ecopoint_local@localhost:5433/ecopoint_test"

# Sessiya cookie imzosi uchun tasodifiy uzun satr (kamida 32 belgi).
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Yuklangan rasmlar saqlanadigan yopiq papka (public emas).
STORAGE_DIR="./storage/uploads"

# Demo rejim: login sahifasida demo akkauntlar va "shartli ma'lumot" belgisi ko'rinadi.
# Production'da (NODE_ENV=production) demo akkauntlar baribir kira olmaydi.
DEMO_MODE="true"

# Ilovaning tashqi manzili (Telegram ulashish havolasi uchun).
APP_URL="http://localhost:3000"

# Ochiq kirish (loginsiz demo): true bo'lsa login o'rniga rol kartalari. Faqat demo uchun!
OPEN_ACCESS="false"
